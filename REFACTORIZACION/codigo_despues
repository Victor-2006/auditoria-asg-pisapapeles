    <div class="fondo-espacio-cookies" style="display:none;" data-nosnippet="data-nosnippet">
        <div class="espacio-cookies">
            <div class="espacio-cookies-scroll">
                <div class="informacion-general-cookies">
                    <div class="texto">
                        Este sitio web utiliza cookies para mejorar su experiencia mientras navega...
                    </div>
                </div>
                
                <div class="tipo_cookie">
                    <p><strong>Imprescindibles</strong></p>
                    <p>Las cookies necesarias son absolutamente esenciales para que el sitio web funcione correctamente.</p>
                </div>
                
                <div class="tipo_cookie">
                    <div class="tipo-cookies-cabecera">
                        <p><strong>No imprescindibles</strong></p>
                        <div class="tipo-cookie-switch">
                            <input id="check_tipo_cookie_no_imprescindible" type="checkbox" class="tipo-cookie-check" checked>
                            <label for="check_tipo_cookie_no_imprescindible"></label>
                        </div>
                    </div>
                    
                    <div class="tipo-cookies-contenido">
                        <button class="boton" type="button" data-toggle="collapse" data-target="#configuracion_cookies">Ver no imprescindibles</button>
                        
                        <div class="text_leg_fCookies collapse" id="configuracion_cookies">
                            <div class="sub-cookie"><p>Google</p><input id="check_tipo_cookie_google" type="checkbox" class="sub-cookie-check" checked></div>
                            <div class="sub-cookie"><p>Google ADS</p><input id="check_tipo_cookie_ads" type="checkbox" class="sub-cookie-check" checked></div>
                            <div class="sub-cookie"><p>Google Analytics</p><input id="check_tipo_cookie_analytics" type="checkbox" class="sub-cookie-check" checked></div>
                            <div class="sub-cookie"><p>Google Recaptcha</p><input id="check_tipo_cookie_grecaptcha" type="checkbox" class="sub-cookie-check" checked></div>
                        </div>
                    </div>
                </div>
                
                <div class="capa_boton">
                    <button class="aceptarConfigurar">Configurar</button>
                    <button class="aceptarSoloBasicas">Básicas</button>
                    <button class="aceptarGuardar">Aceptar todas</button>
                </div>
            </div>
        </div>
    </div>

    <header>
        <div class="busquedaCesta">
            <div class="container">
                <div class="row">
                    
                    <div id="header_logo" class="col-xs-12 col-sm-4 col-md-3">
                        <a href="/" title="Volver al inicio">
                            <img class="logo img-responsive" src="https://www.pisapapeles.es/upload/img/logotipos/1752669785__logo_completo.png" alt="Librería Pisapapeles">
                        </a>
                    </div>
                    
                    <nav class="nav">
                        <ul id="header_links">
                            <li><a href="https://www.pisapapeles.es/acceso" class="account">Iniciar Sesión</a></li>
                            <li><a href="https://www.pisapapeles.es/registro" class="hidden-xs">Registrarse</a></li>
                        </ul>
                    </nav>
                    
                    <div id="sticky_top" class="col-xs-6 col-sm-12 col-md-9">
                        <form method="post" action="https://www.pisapapeles.es/buscar" id="searchbox">
                            <input class="search_query" type="text" id="search_query_top" name="txt_busqueda" placeholder="Autor, Título, Editorial" required>
                            <button type="submit" title="Buscar" class="boton"><i class="mdi mdi-magnify"></i></button>
                        </form>
                    </div>

                    <div class="shopping_cart_menu">
                        <div class="cesta_desplegableV2">
                            <div class="webStoreDropDown" id="_cesta_contenedor">
                                <div class="contenedor_cesta_desplegable">
                                    <div class="cesta_vaciar">
                                        <a href="javascript:void(0);" title="Vaciar cesta" id="btn_vaciar_cesta">Vaciar</a>
                                    </div>
                                    <div class="contenedor_totales_cesta" id="bloque_total_cesta"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </header>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const preloader = document.querySelector('.preloader');
            if(preloader) preloader.style.display = 'none';

            const searchForm = document.getElementById('searchbox');
            const searchInput = document.getElementById('search_query_top');
            
            searchForm.addEventListener('submit', (e) => {
                if (!searchInput.value.trim()) {
                    e.preventDefault();
                    searchInput.focus();
                }
            });

            const mainCookieCheck = document.getElementById('check_tipo_cookie_no_imprescindible');
            const subCookieChecks = document.querySelectorAll('.sub-cookie-check');
            const cookieBanner = document.querySelector('.fondo-espacio-cookies');

            if(!localStorage.getItem('cookies_accepted')) {
                cookieBanner.style.display = 'block';
            }

            mainCookieCheck.addEventListener('change', (e) => {
                subCookieChecks.forEach(check => check.checked = e.target.checked);
            });

            subCookieChecks.forEach(checkbox => {
                checkbox.addEventListener('change', () => {
                    mainCookieCheck.checked = Array.from(subCookieChecks).some(c => c.checked);
                });
            });

            document.querySelector('.aceptarGuardar').addEventListener('click', () => saveCookiePreferences(true));
            document.querySelector('.aceptarSoloBasicas').addEventListener('click', () => saveCookiePreferences(false));
            
            function saveCookiePreferences(allAccepted) {
                localStorage.setItem('cookies_accepted', allAccepted ? 'all' : 'basic');
                cookieBanner.style.display = 'none';
            }

            document.getElementById('btn_vaciar_cesta').addEventListener('click', () => {
                if (confirm('¿Desea vaciar la cesta por completo?\nEsta operación no tiene marcha atrás.')) {
                    location.reload();
                }
            });
        });
    </script>
